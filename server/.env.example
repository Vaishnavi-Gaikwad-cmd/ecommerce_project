# Choose Resend (recommended) or SMTP. Copy values into server/.env.
RESEND_API_KEY=re_xxxxxxxxx
ORDER_EMAIL_FROM=THREADFORM <orders@your-verified-domain.com>

# SMTP alternative:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
